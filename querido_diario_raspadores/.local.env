# AWS_ACCESS_KEY_ID=minio-access-key
# AWS_SECRET_ACCESS_KEY=minio-secret-key
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_REGION_NAME=nyc3
# FILES_STORE=s3://queridodiariobucket/
# FILES_STORE_SECONDARY=s3://queridodiariobucket-secondary/
# QUERIDODIARIO_DATABASE_URL=postgresql://queridodiario:queridodiario@localhost:5432/queridodiariodb
# Vazio de propósito: scripts/spider.py (querido-diario-deployment) conecta
# automaticamente ao Postgres e ao Garage (S3) do cluster kind local via
# port-forward temporário quando QUERIDODIARIO_DATABASE_URL / FILES_STORE
# não estão definidas aqui. Só preencha manualmente se quiser apontar pra
# outro ambiente (ex: Revoada) — nesse caso, o que estiver aqui tem
